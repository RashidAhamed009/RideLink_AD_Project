{
  "info": {
    "name": "RideLink API Collection",
    "_postman_id": "7d9b23f8-8a94-4e2b-b892-0b1a32f91a22",
    "description": "Comprehensive Postman collection for the RideLink Microservices Platform covering Account, Driver & Vehicle, Ride Management, and Fare & Payment services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Account Service",
      "item": [
        {
          "name": "Register Passenger",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{accountServiceUrl}}/api/v1/auth/register/passenger"
          }
        },
        {
          "name": "Register Driver",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Driver\",\n  \"email\": \"alex.driver@example.com\",\n  \"password\": \"DriverPass123!\"\n}"
            },
            "url": "{{accountServiceUrl}}/api/v1/auth/register/driver"
          }
        },
        {
          "name": "Login Passenger",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"passengerToken\", jsonData.token);",
                  "    pm.environment.set(\"passengerId\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{accountServiceUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"driverToken\", jsonData.token);",
                  "    pm.environment.set(\"driverId\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.driver@example.com\",\n  \"password\": \"DriverPass123!\"\n}"
            },
            "url": "{{accountServiceUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Get Own Profile",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{accountServiceUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Update Own Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor Updated\"\n}"
            },
            "url": "{{accountServiceUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Negative - Duplicate Registration",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{accountServiceUrl}}/api/v1/auth/register/passenger"
          }
        },
        {
          "name": "Negative - Invalid Credentials",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "url": "{{accountServiceUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Driver & Vehicle Service",
      "item": [
        {
          "name": "Create or Update Driver Operational Profile",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licenseNumber\": \"LIC-LK-90210\",\n  \"serviceArea\": \"COLOMBO_CENTRAL\",\n  \"latitude\": 6.9271,\n  \"longitude\": 79.8612,\n  \"locationName\": \"Colombo Fort Station\"\n}"
            },
            "url": "{{driverServiceUrl}}/api/v1/drivers/profile"
          }
        },
        {
          "name": "Add Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.vehicleId) {",
                  "    pm.environment.set(\"vehicleId\", jsonData.vehicleId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"CAB-4567\",\n  \"make\": \"Toyota\",\n  \"model\": \"Prius\",\n  \"vehicleType\": \"SEDAN\",\n  \"color\": \"Pearl White\",\n  \"year\": 2022\n}"
            },
            "url": "{{driverServiceUrl}}/api/v1/drivers/vehicles"
          }
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"CAB-4567\",\n  \"make\": \"Toyota\",\n  \"model\": \"Prius Prime\",\n  \"vehicleType\": \"SEDAN\",\n  \"color\": \"Metallic Silver\",\n  \"year\": 2023\n}"
            },
            "url": "{{driverServiceUrl}}/api/v1/drivers/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "View Driver Details",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "url": "{{driverServiceUrl}}/api/v1/drivers/{{driverId}}"
          }
        },
        {
          "name": "Update Availability Status",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": "{{driverServiceUrl}}/api/v1/drivers/{{driverId}}/availability"
          }
        },
        {
          "name": "Update Simulated Location",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 6.9344,\n  \"longitude\": 79.8428,\n  \"locationName\": \"Galle Face Green, Colombo\"\n}"
            },
            "url": "{{driverServiceUrl}}/api/v1/drivers/{{driverId}}/location"
          }
        },
        {
          "name": "Retrieve Eligible Available Drivers",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{driverServiceUrl}}/api/v1/drivers/available?latitude=6.9344&longitude=79.8428&radiusKm=10.0"
          }
        },
        {
          "name": "Negative - Duplicate Vehicle Registration",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"CAB-4567\",\n  \"make\": \"Toyota\",\n  \"model\": \"Prius\",\n  \"vehicleType\": \"SEDAN\",\n  \"color\": \"Pearl White\",\n  \"year\": 2022\n}"
            },
            "url": "{{driverServiceUrl}}/api/v1/drivers/vehicles"
          }
        },
        {
          "name": "Negative - Invalid Location Latitude",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 195.0,\n  \"longitude\": 79.8428,\n  \"locationName\": \"Invalid Latitude\"\n}"
            },
            "url": "{{driverServiceUrl}}/api/v1/drivers/{{driverId}}/location"
          }
        }
      ]
    },
    {
      "name": "3. Ride Management Service",
      "item": [
        {
          "name": "Create Ride Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.rideId) {",
                  "    pm.environment.set(\"rideId\", jsonData.rideId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"address\": \"Colombo Fort Station\",\n    \"latitude\": 6.9344,\n    \"longitude\": 79.8428\n  },\n  \"destination\": {\n    \"address\": \"Bambalapitiya Junction\",\n    \"latitude\": 6.8918,\n    \"longitude\": 79.8587\n  },\n  \"estimatedDistanceKm\": 6.2,\n  \"estimatedDurationMinutes\": 18.0\n}"
            },
            "url": "{{rideServiceUrl}}/api/v1/rides"
          }
        },
        {
          "name": "Get Ride by ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}"
          }
        },
        {
          "name": "Get Passenger Rides",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{rideServiceUrl}}/api/v1/rides/passenger/{{passengerId}}"
          }
        },
        {
          "name": "Find Eligible Drivers for Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (Array.isArray(jsonData) && jsonData.length > 0 && jsonData[0].driverId) {",
                  "    pm.environment.set(\"driverId\", jsonData[0].driverId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/eligible-drivers"
          }
        },
        {
          "name": "Assign Driver to Ride",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\"\n}"
            },
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/assign"
          }
        },
        {
          "name": "Accept Ride (Driver)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/accept"
          }
        },
        {
          "name": "Start Ride (Driver)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/start"
          }
        },
        {
          "name": "Complete Ride & Settle Payment (Driver)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.receiptId) {",
                  "    pm.environment.set(\"receiptId\", jsonData.receiptId);",
                  "}",
                  "if (jsonData.paymentReference) {",
                  "    pm.environment.set(\"paymentReference\", jsonData.paymentReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualDistanceKm\": 6.5,\n  \"actualDurationMinutes\": 20.0,\n  \"paymentMethod\": \"SIMULATED_WALLET\",\n  \"surgeMultiplier\": 1.0\n}"
            },
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/complete"
          }
        },
        {
          "name": "Cancel Ride",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed pickup plans\"\n}"
            },
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/cancel"
          }
        },
        {
          "name": "Get Driver Rides",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "url": "{{rideServiceUrl}}/api/v1/rides/driver/{{driverId}}"
          }
        },
        {
          "name": "Negative - Invalid State Transition (409 Conflict)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualDistanceKm\": 5.0,\n  \"actualDurationMinutes\": 15.0\n}"
            },
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/complete"
          }
        },
        {
          "name": "Negative - Unauthorized Driver Accept (403 Forbidden)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{rideServiceUrl}}/api/v1/rides/{{rideId}}/accept"
          }
        }
      ]
    },
    {
      "name": "4. Fare & Payment Service",
      "item": [
        {
          "name": "Calculate Upfront Fare Estimate",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"ride-demo-101\",\n  \"pickup\": \"Colombo Fort Station\",\n  \"destination\": \"Bambalapitiya Junction\",\n  \"distanceKm\": 6.2,\n  \"durationMinutes\": 18.0\n}"
            },
            "url": "{{paymentServiceUrl}}/api/v1/fares/estimate"
          }
        },
        {
          "name": "Calculate Final Ride Fare",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{driverToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"ride-demo-101\",\n  \"distanceKm\": 6.5,\n  \"durationMinutes\": 20.0,\n  \"surgeMultiplier\": 1.2\n}"
            },
            "url": "{{paymentServiceUrl}}/api/v1/fares/calculate"
          }
        },
        {
          "name": "Simulate Payment Transaction - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.paymentId) {",
                  "    pm.environment.set(\"paymentId\", jsonData.paymentId);",
                  "}",
                  "if (jsonData.receiptId) {",
                  "    pm.environment.set(\"receiptId\", jsonData.receiptId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"ride-demo-101\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"amount\": 21.30,\n  \"paymentMethod\": \"SIMULATED_WALLET\",\n  \"simulateFailure\": false\n}"
            },
            "url": "{{paymentServiceUrl}}/api/v1/payments/process"
          }
        },
        {
          "name": "Simulate Payment Decline (Negative Case)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"ride-demo-fail-999\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"amount\": 35.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"simulateFailure\": true,\n  \"failureReason\": \"INSUFFICIENT_FUNDS\"\n}"
            },
            "url": "{{paymentServiceUrl}}/api/v1/payments/process"
          }
        },
        {
          "name": "Negative - Duplicate Payment Rejection (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"ride-demo-101\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"amount\": 21.30,\n  \"paymentMethod\": \"SIMULATED_WALLET\",\n  \"simulateFailure\": false\n}"
            },
            "url": "{{paymentServiceUrl}}/api/v1/payments/process"
          }
        },
        {
          "name": "Retrieve Payment by Ride ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{paymentServiceUrl}}/api/v1/payments/rides/{{rideId}}"
          }
        },
        {
          "name": "Retrieve Payment by Payment ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{paymentServiceUrl}}/api/v1/payments/{{paymentId}}"
          }
        },
        {
          "name": "Retrieve Itemized Receipt by Receipt ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{paymentServiceUrl}}/api/v1/payments/receipts/{{receiptId}}"
          }
        },
        {
          "name": "Retrieve Itemized Receipt by Ride ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{passengerToken}}"}
            ],
            "url": "{{paymentServiceUrl}}/api/v1/payments/receipts/rides/{{rideId}}"
          }
        }
      ]
    }
  ]
}
